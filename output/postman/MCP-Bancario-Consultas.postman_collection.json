            "value": "2025-11-25"
          }
        ],
        "url": "{{mcpUrl}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"listarMovimientos\",\n    \"arguments\": {\n      \"numeroCuenta\": \"1001\"\n    }\n  },\n  \"id\": 6\n}",
          "options": {
