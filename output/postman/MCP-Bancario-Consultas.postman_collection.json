          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"consultarSaldo\",\n    \"arguments\": {\n      \"numeroCuenta\": \"1002\"\n    }\n  },\n  \"id\": 5\n}",
          "options": {
